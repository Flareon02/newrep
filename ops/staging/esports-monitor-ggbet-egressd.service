[Unit]
Description=Esports Monitor GGBET egress controller (one Mullvad netns egress, transport failover, proxy last resort)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root: creates/removes the ggbet-egress network namespace and WireGuard interface. The host namespace is never changed.
ExecStart=/usr/local/bin/node /opt/esports-monitor/current/tools/ggbet-egressd.mjs --preferred ggbet-good.conf
Restart=always
RestartSec=10
KillSignal=SIGTERM
SyslogIdentifier=ggbet-egressd
NoNewPrivileges=true
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target

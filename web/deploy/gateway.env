# /etc/esportsdata-web/gateway.env - no secrets here (the API token is a systemd credential).
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8090
DATA_DIR=/var/lib/esportsdata-web
STATIC_DIR=/opt/esportsdata-web/current/dist/web
DOWNLOADS_DIR=/var/lib/esportsdata-web/downloads
UPSTREAM_BASE=http://127.0.0.1:80
PUBLIC_ORIGIN=https://esportsdata.online
COOKIE_SECURE=true
TRUST_CLOUDFLARE_HEADERS=true
SESSION_IDLE_DAYS=30
SESSION_MAX_DAYS=90
ADMIN_SESSION_MAX_DAYS=7

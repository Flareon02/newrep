{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Esports Data",
  "mainBinaryName": "EsportsData",
  "version": "../package.json",
  "identifier": "online.esportsdata.desktop",
  "build": {
    "frontendDist": "../../dist/tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Esports Monitor · Esports Data",
        "width": 1320,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://esportsdata.online https://v2l.traincdn.com https://cdn.cross.bet https://hawk.live https://cdn.gin.bet",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://esportsdata.online",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Esports Data",
    "copyright": "Esports Data",
    "shortDescription": "Esports Monitor desktop app",
    "longDescription": "LIVE, line, results and History across bookmakers - the Esports Monitor interface as a desktop app.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Russian", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyQzNGQjhFOUI0OEI2QjIKUldTeXRraWJqdnZEZ3NnT2g0VDQ3SmsrdGRVcDNnS1FzaHNKME1MekFta3JyRWFmOHluaFZBUjIK",
      "endpoints": [
        "https://esportsdata.online/downloads/desktop/latest.json",
        "https://github.com/Flareon02/newrep/releases/download/desktop-stable/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}

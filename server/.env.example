# Copy to .env (never commit the real .env). docker-compose reads these values.
# All variables are optional; defaults are defined in docker-compose.yml.

# Optional GGBET bootstrap relay. Leave empty to connect directly.
# Normally written by ./configure-ggbet-relay.sh from a relay bundle.
GGBET_BOOTSTRAP_RELAY_URL=

# Host directory mounted as /data (SQLite storage). Default: ./data
# Normally written by ./upgrade.sh to point at the existing production data.
HOST_DATA_DIR=./data

# Files with the relay shared secret and relay CA certificate (mounted read-only).
# The real files are NOT stored in Git; they are created by configure-ggbet-relay.sh.
GGBET_RELAY_SECRET_FILE=./secrets/ggbet-relay-secret
GGBET_RELAY_CA_FILE=./secrets/ggbet-relay-ca.pem

# Docker Compose project name (set by ./upgrade.sh / ./install.sh). Optional.
COMPOSE_PROJECT_NAME=

# Directory used by backup.sh for database backups (optional, see backup.sh).
ASTEK_BACKUP_DIR=

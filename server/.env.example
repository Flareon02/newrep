# Copy to .env (never commit the real .env). docker-compose reads these values.
# All variables are optional; defaults are defined in docker-compose.yml.

# Optional GGBET bootstrap relay. Leave empty to connect directly.
# Normally written by ./configure-ggbet-relay.sh from a relay bundle.
GGBET_BOOTSTRAP_RELAY_URL=

# Host directory mounted as /data (SQLite storage). Default: ./data
# Normally written by ./upgrade.sh to point at the existing production data.
HOST_DATA_DIR=./data

# Files with the relay shared secret and relay CA certificate (mounted read-only).
# The real files are NOT stored in Git; they are created by configure-ggbet-relay.sh.
GGBET_RELAY_SECRET_FILE=./secrets/ggbet-relay-secret
GGBET_RELAY_CA_FILE=./secrets/ggbet-relay-ca.pem

# Docker Compose project name (set by ./upgrade.sh / ./install.sh). Optional.
COMPOSE_PROJECT_NAME=

# Directory used by backup.sh for database backups (optional, see backup.sh).
ASTEK_BACKUP_DIR=

# Log verbosity: error | warn | info (default) | debug (logs every poll; diagnostics only).
LOG_LEVEL=info

# Administrator key (>= 16 characters). Generate one with: openssl rand -hex 24
# Set: every API read needs a key - this one (administrator, everything) or a per-user key created in the
# extension (Settings -> Пользователи); a new user starts with every capability off. Only the bare /health is public.
# Empty: the previous open behaviour (everything except administration, no users).
# The administrator puts the same value into the extension: Settings -> Подключение -> Ключ доступа.
API_TOKEN=
# auto (default): per-user capabilities are enforced whenever API_TOKEN is set. open: ignore users, legacy access.
ACCESS_CONTROL=auto

# Optional retention (days). 0 = keep forever (default). Enable when disk space runs low; only whole
# events whose newest record is older than the limit AND that are no longer in any feed are deleted.
# Recommended starting point: 365.
ODDS_RETENTION_DAYS=0
SCORE_RETENTION_DAYS=0
STATISTICS_RETENTION_DAYS=0

# History lives in SQLite; only rows with activity in the last HISTORY_HOT_DAYS days are kept in RAM
# (about 1.1 KB per resident row), so memory no longer depends on how long history is retained.
# /health -> runtime.history shows resident rows, persisted rows and a level (ok/high/critical).
# HISTORY_HOT_DAYS=7          0 = keep everything in RAM (old behaviour)
# HISTORY_MAX=100000          rows kept per snapshot in SQLite; older rows are deleted on the next save
# HISTORY_TTL_MS=31537000000  age limit (about one year)
